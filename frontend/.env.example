# ==============================================================================
# NyayaNiti — Frontend Environment Template (Vite / React)
# ==============================================================================
# Usage:
# - For local development: leave empty or unset; Vite proxies '/api' to 'http://127.0.0.1:8000'.
# - For staging preview: set VITE_API_URL to the staging backend URL.
# - For production Vercel: set VITE_API_URL in Vercel Project Settings.
#
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser.
# NEVER place backend secrets, database passwords, or JWT SECRET_KEY in frontend .env!

# Base URL of the NyayaNiti FastAPI Backend (Optional: defaults to relative '/api')
# Development (default / proxy): (leave commented out or set to empty)
# VITE_API_URL=

# Staging Environment:
# VITE_API_URL=https://nyayaniti-staging.onrender.com

# Production Environment:
VITE_API_URL=https://nyayaniti-aicte-integrated-institution.onrender.com
