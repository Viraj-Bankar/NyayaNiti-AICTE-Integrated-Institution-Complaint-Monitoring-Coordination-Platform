# ==============================================================================
# NyayaNiti — Local Development Environment Template
# ==============================================================================
# Usage: Copy this file to 'backend/.env' for local development.
# Never commit actual secret-bearing '.env' files to Git.

# Operational Environment (Required: 'development' | 'staging' | 'production')
APP_ENV=development

# Application Secret Key (Optional in development: defaults to dev fallback)
# In production/staging, must be a cryptographically random string >= 32 characters.
SECRET_KEY=nyayaniti-dev-secret-key-32chars-minimum-fallback

# Database Connection URL (Optional in development: defaults to local SQLite)
# Format: sqlite:///./nyayaniti.db
DATABASE_URL=sqlite:///./nyayaniti.db

# CORS Allowed Origins (Required: JSON array of authorized web origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# JWT Access Token Lifetime (Optional: defaults to 1440 minutes / 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Startup Schema Migration & Seeding Controls (Optional: defaults to True in dev)
# AUTO_MIGRATE: automatically creates missing tables via Base.metadata.create_all()
AUTO_MIGRATE=true
# AUTO_SEED: automatically populates initial development mock data if database is empty
AUTO_SEED=true

# Persistent Document & Evidence Storage (Zero-Cost Architecture)
# Backend: 'neon_bytea' (recommended) | 'local' | 'filesystem'
DOCUMENT_STORAGE_BACKEND=neon_bytea
# Local storage root for development or legacy filesystem fallback
DOCUMENT_STORAGE_ROOT=./storage/docs
# Maximum file upload size in MB (Strictly enforced at 3 MB across all environments)
DOCUMENT_STORAGE_MAX_FILE_SIZE_MB=3
# Allowed document extensions (JSON array)
DOCUMENT_STORAGE_ALLOWED_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".docx"]
# Estimated quota threshold for monitoring diagnostics (MB)
DOCUMENT_STORAGE_ASSUMED_QUOTA_MB=512

# AI Duplicate Detection & ML Configuration (Optional: defaults pre-configured)
SBERT_MODEL_NAME=all-MiniLM-L6-v2
OVERLAP_HIGH_THRESHOLD=0.82
OVERLAP_REVIEW_THRESHOLD=0.60
RAPIDFUZZ_NAME_SIMILARITY_THRESHOLD=78.0

# Surge Alert Detection (Optional: defaults pre-configured)
SURGE_Z_SCORE_THRESHOLD=1.8
SURGE_MIN_COMPLAINT_COUNT=3
SURGE_WINDOW_DAYS=30

# Statutory SLA Deadlines in Days (Optional: defaults pre-configured)
SLA_CRITICAL_DAYS=7
SLA_HIGH_DAYS=15
SLA_MEDIUM_DAYS=30
SLA_LOW_DAYS=45

