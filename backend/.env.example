# NyayaNiti Backend Configuration Example
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-char-key-in-production
DATABASE_URL=sqlite:///./nyayaniti.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
AUTO_MIGRATE=true
AUTO_SEED=true

# Zero-Cost Persistent Document Storage Configuration
# Supported DOCUMENT_STORAGE_BACKEND values: 'neon_bytea' (recommended zero-cost production), 'local' (development), 'render_disk', 'filesystem'
DOCUMENT_STORAGE_BACKEND=neon_bytea
# Filesystem root for local development or legacy file resolution
DOCUMENT_STORAGE_ROOT=./storage/docs
DOCUMENT_STORAGE_MAX_FILE_SIZE_MB=3
