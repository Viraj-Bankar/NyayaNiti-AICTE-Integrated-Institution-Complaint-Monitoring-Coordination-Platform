# ==============================================================================
# NyayaNiti — Render Production Environment Template
# ==============================================================================
# Usage: Configure these environment variables in the Render Dashboard:
# Dashboard -> Service -> Environment Variables.
# Never commit actual production secrets or connection strings to Git.

# Operational Environment (Required: must be 'production')
APP_ENV=production

# Application Secret Key (Required: MUST be supplied manually in Render)
# Must be a unique, cryptographically random string >= 32 characters.
# DO NOT reuse development fallback key or staging SECRET_KEY.
SECRET_KEY=<GENERATE_UNIQUE_PRODUCTION_SECRET_KEY_MIN_32_CHARS>

# Database Connection URL (Required: MUST be supplied manually in Render)
# Points to production Neon Lakebase Postgres (Primary compute endpoint).
# Format: postgresql+psycopg://<PROD_USER>:<PROD_PASSWORD>@ep-prod-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://<PROD_USER>:<PROD_PASSWORD>@ep-prod-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Required: JSON array of authorized production origins)
CORS_ORIGINS=["https://nyaya-niti-aicte-integrated-institu.vercel.app"]

# JWT Access Token Lifetime (Optional: defaults to 1440 minutes / 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Startup Schema Migration & Seeding Controls (Required: False in production)
# Schema changes in production must be managed through controlled migrations
AUTO_MIGRATE=false
# Never inject development seed records into production
AUTO_SEED=false

# Persistent Document & Evidence Storage (Zero-Cost Architecture)
# Operates via zero-cost PostgreSQL BYTEA storage; no Render Persistent Disk required ($0.00)
DOCUMENT_STORAGE_BACKEND=neon_bytea
DOCUMENT_STORAGE_ROOT=./storage/docs
DOCUMENT_STORAGE_MAX_FILE_SIZE_MB=3
DOCUMENT_STORAGE_ALLOWED_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".docx"]
DOCUMENT_STORAGE_ASSUMED_QUOTA_MB=512

# AI Duplicate Detection & ML Configuration (Optional: defaults pre-configured)
SBERT_MODEL_NAME=all-MiniLM-L6-v2
OVERLAP_HIGH_THRESHOLD=0.82
OVERLAP_REVIEW_THRESHOLD=0.60
RAPIDFUZZ_NAME_SIMILARITY_THRESHOLD=78.0

# Surge Alert Detection (Optional: defaults pre-configured)
SURGE_Z_SCORE_THRESHOLD=1.8
SURGE_MIN_COMPLAINT_COUNT=3
SURGE_WINDOW_DAYS=30

# Statutory SLA Deadlines in Days (Optional: defaults pre-configured)
SLA_CRITICAL_DAYS=7
SLA_HIGH_DAYS=15
SLA_MEDIUM_DAYS=30
SLA_LOW_DAYS=45

