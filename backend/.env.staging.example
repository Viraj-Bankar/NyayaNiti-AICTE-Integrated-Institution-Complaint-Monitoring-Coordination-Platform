# ==============================================================================
# NyayaNiti — Staging Environment Template
# ==============================================================================
# Usage: Copy this file to 'backend/.env.staging.local' (git-ignored) for staging validation.
# Never commit actual secret-bearing '.env' files to Git.

# Operational Environment (Required: must be 'staging')
APP_ENV=staging

# Application Secret Key (Required: MUST be supplied manually)
# Must be a unique, cryptographically random string >= 32 characters.
# DO NOT reuse development fallback key or production SECRET_KEY.
SECRET_KEY=<GENERATE_UNIQUE_STAGING_SECRET_KEY_MIN_32_CHARS>

# Database Connection URL (Required: MUST be supplied manually)
# Must point to the isolated Neon staging branch ('staging-bytea') using runtime app role.
# Runtime role: 'nyayaniti_staging_app' (DML only, STRICTLY NO DDL).
# Format: postgresql+psycopg://<staging_app_user>:<staging_app_password>@<staging_endpoint>.neon.tech/<staging_db>?sslmode=require
DATABASE_URL=postgresql+psycopg://nyayaniti_staging_app:<STAGING_APP_PASSWORD>@ep-staging-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Required: JSON array of authorized staging origins)
# Include staging Vercel preview origin and local dev harness
CORS_ORIGINS=["https://nyayaniti-staging.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# JWT Access Token Lifetime (Optional: defaults to 1440 minutes / 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Startup Schema Migration & Seeding Controls (Required: MUST be False in staging)
# Disables runtime DDL; schema must be pre-created by migration owner role via init_staging_schema.sql
AUTO_MIGRATE=false
# Disables automatic development seeding; staging data is populated via seed_staging_synthetic.py
AUTO_SEED=false

# Persistent Document & Evidence Storage (Zero-Cost Architecture)
# Staging validates PostgreSQL BYTEA storage against the Neon staging database
DOCUMENT_STORAGE_BACKEND=neon_bytea
DOCUMENT_STORAGE_ROOT=./storage/docs
DOCUMENT_STORAGE_MAX_FILE_SIZE_MB=3
DOCUMENT_STORAGE_ALLOWED_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".docx"]
DOCUMENT_STORAGE_ASSUMED_QUOTA_MB=512

# AI Duplicate Detection & ML Configuration (Optional: defaults pre-configured)
SBERT_MODEL_NAME=all-MiniLM-L6-v2
OVERLAP_HIGH_THRESHOLD=0.82
OVERLAP_REVIEW_THRESHOLD=0.60
RAPIDFUZZ_NAME_SIMILARITY_THRESHOLD=78.0

# Surge Alert Detection (Optional: defaults pre-configured)
SURGE_Z_SCORE_THRESHOLD=1.8
SURGE_MIN_COMPLAINT_COUNT=3
SURGE_WINDOW_DAYS=30

# Statutory SLA Deadlines in Days (Optional: defaults pre-configured)
SLA_CRITICAL_DAYS=7
SLA_HIGH_DAYS=15
SLA_MEDIUM_DAYS=30
SLA_LOW_DAYS=45

